# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Electron / Vite
/.vite/
/release/
*.dmp
*.blockmap
latest*.yml
/.cache/

# Artefacts binaires et archives de publication
*.exe
*.msi
*.dll
*.zip
*.7z
*.tar
*.tar.gz
*.tar.xz

# Données locales sensibles
*.jsonl
*.key
*.mmdb
Thumbs.db

# Moteur P2P, identifiants RPC, journaux et contenus locaux
/.runtime/
*.torrent
*.resume
*.part
