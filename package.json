{
  "name": "slyorrent",
  "productName": "Slyorrent",
  "version": "1.1.11",
  "private": true,
  "description": "Client torrent pour Windows avec médiathèque et lecteur intégré.",
  "author": "Slyreus",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/Slyreus/Slyorent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Slyreus/Slyorent.git"
  },
  "bugs": {
    "url": "https://github.com/Slyreus/Slyorent/issues"
  },
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "npm run build && electron .",
    "local": "npm run start",
    "engine:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-engine.ps1",
    "network:install": "node scripts/install-network.mjs",
    "media:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-media.ps1",
    "runtime:install": "npm run engine:install && npm run network:install && npm run media:install",
    "icons:build": "node scripts/build-icons.mjs",
    "guard:local": "node scripts/assert-local-only.mjs",
    "guard:public": "node scripts/assert-public-safe.mjs",
    "guard:release": "node scripts/assert-public-release.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:media-ui": "node scripts/test-media-ui.mjs",
    "test:catalog-ui": "node scripts/test-media-ui.mjs --catalog",
    "test:packaged-media": "node scripts/test-packaged-media.mjs",
    "test:map-ui": "node scripts/test-map-ui.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .runtime",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run guard:local && npm run guard:public && npm run typecheck && npm run lint && npm test && npm run build",
    "pack:win": "npm run check && electron-builder --win dir --x64",
    "dist:win": "npm run check && electron-builder --win nsis --x64 && npm run guard:release && npm run test:packaged-media",
    "release:win": "npm run runtime:install && npm run dist:win"
  },
  "dependencies": {
    "geoip-lite": "2.0.3",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "yauzl": "3.4.0"
  },
  "type": "module",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  }
}
